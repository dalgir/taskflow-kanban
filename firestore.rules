rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /*
     * ========================================
     * AUTENTICAÇÃO
     * ========================================
     */

    function signedIn() {
      return request.auth != null;
    }

    // O documento do membro usa o UID do Firebase.
    function memberPath() {
      return /databases/$(database)/documents/teamMembers/$(request.auth.uid);
    }

    function memberDoc() {
      return get(memberPath());
    }

    function memberData() {
      return memberDoc().data;
    }

    /*
     * ========================================
     * MEMBRO ATIVO
     * ========================================
     */

    function activeMember() {
      return signedIn()
        && exists(memberPath())
        && memberData().isActive == true
        && memberData().email == request.auth.token.email
        && (
          !('firebaseUid' in memberData())
          || memberData().firebaseUid == request.auth.uid
        );
    }

    /*
     * ========================================
     * ADMINISTRADOR
     * ========================================
     */

    function isAdmin() {
      return activeMember()
        && memberData().isAdmin == true
        && request.auth.token.get('isAdmin', false) == true
        && request.auth.token.get('memberId', '') == memberData().id;
    }

    /*
     * ========================================
     * PRÓPRIO USUÁRIO
     * ========================================
     */

    function isSelf(userId) {
      return activeMember()
        && request.auth.uid == userId;
    }

    // Compara o ID interno do TaskFlow.
    function isSelfByMemberId(memberId) {
      return activeMember()
        && memberData().id == memberId;
    }

    /*
     * ========================================
     * STATUS DE TAREFAS
     * ========================================
     */

    function validTaskStatus(status) {
      return status in [
        'planned',
        'in_progress',
        'awaiting_validation',
        'completed',
        'approved'
      ];
    }

    /*
     * ========================================
     * VALIDAÇÃO DOS DADOS DA TAREFA
     * ========================================
     */

    function validTaskPayload(data) {
      return data.keys().hasAll([
          'id',
          'title',
          'description',
          'status',
          'columnId',
          'createdAt',
          'createdBy'
        ])

        // Somente estes campos podem existir na tarefa.
        && data.keys().hasOnly([
          'id',
          'title',
          'description',
          'assigneeId',
          'startDate',
          'dueDate',
          'status',
          'checklist',
          'comments',
          'attachments',
          'columnId',
          'createdAt',
          'createdBy',
          'validationStatus',
          'validationComment'
        ])

        && data.id is string
        && data.id.size() > 0

        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 150

        && data.description is string
        && data.description.size() <= 5000

        && validTaskStatus(data.status)

        && data.columnId is string
        && data.columnId.size() > 0

        && data.createdBy is string
        && data.createdBy.size() > 0

        // O serviço atual grava datas como texto.
        && data.createdAt is string
        && data.createdAt.size() > 0
        && data.createdAt.size() <= 40

        // Responsável pode estar ausente ou ser null.
        && (
          data.get('assigneeId', null) == null
          || (
            data.assigneeId is string
            && data.assigneeId.size() > 0
          )
        )

        // Datas opcionais.
        && (
          data.get('startDate', null) == null
          || (
            data.startDate is string
            && data.startDate.size() > 0
            && data.startDate.size() <= 40
          )
        )

        && (
          data.get('dueDate', null) == null
          || (
            data.dueDate is string
            && data.dueDate.size() > 0
            && data.dueDate.size() <= 40
          )
        )

        // Quando presentes, estes campos precisam ser listas.
        && data.get('checklist', []) is list
        && data.get('comments', []) is list
        && data.get('attachments', []) is list

        && (
          !('validationStatus' in data)
          || data.validationStatus in [
            'approved',
            'needs_adjustment'
          ]
        )

        && (
          !('validationComment' in data)
          || (
            data.validationComment is string
            && data.validationComment.size() <= 5000
          )
        );
    }

    /*
     * ========================================
     * LEITURA E CRIAÇÃO DE TAREFAS
     * ========================================
     */

    function canReadTask(data) {
  return isAdmin()
    || data.get('assigneeId', null) == memberData().id
    || data.createdBy == memberData().id;
}

function canWriteTask(data) {
  return isAdmin()
    || data.get('assigneeId', null) == memberData().id
    || data.createdBy == memberData().id;
}

    /*
     * ========================================
     * MEMBROS DA EQUIPE
     * ========================================
     */

    match /teamMembers/{userId} {

      // Permite consultar o próprio cadastro durante o login.
      // Membros ativos também podem consultar outros membros.
      allow get: if signedIn()
        && (
          request.auth.uid == userId
          || activeMember()
        );

      // Permite consultar a equipe somente para membros ativos.
      allow list: if activeMember();

      // A criação de membros é feita pela API administrativa.
      allow create: if false;

      // Pelo aplicativo, permite apenas editar o próprio perfil.
      // Alterações administrativas passam pela API.
      
      allow update: if isSelf(userId)
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly(['name', 'avatar', 'avatarUrl'])

        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 150

        && request.resource.data.avatar is string
        && request.resource.data.avatar.size() <= 100;

      // A exclusão de membros é feita pela API administrativa.
      allow delete: if false;
    }

    /*
     * ========================================
     * TAREFAS
     * ========================================
     */

    match /tasks/{taskId} {

      // Admin lê todas.
      // Membro lê tarefas atribuídas a ele ou criadas por ele.
      allow read: if activeMember()
        && canReadTask(resource.data);

      // Regra de criação preservada.
      allow create: if activeMember()
        && validTaskPayload(request.resource.data)
        && request.resource.data.id == taskId
        && canWriteTask(request.resource.data);

      function validNewComment(comment) {
        return comment is map
          && comment.keys().hasAll([
            'id',
            'userId',
            'text',
            'createdAt'
          ])
          && comment.keys().hasOnly([
            'id',
            'userId',
            'text',
            'createdAt'
          ])

          && comment.id is string
          && comment.id.size() > 0
          && comment.id.size() <= 128

          && comment.userId == memberData().id

          && comment.text is string
          && comment.text.size() > 0
          && comment.text.size() <= 5000

          // O serviço atual grava datas como texto.
          && comment.createdAt is string
          && comment.createdAt.size() > 0
          && comment.createdAt.size() <= 40;
      }

      function onlyAddsOwnComment() {
        let previous = resource.data.get('comments', []);
        let next = request.resource.data.get('comments', []);

        return previous is list
          && next is list

          // Nenhum campo além de comments pode mudar.
          && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly(['comments'])

          // Acrescenta exatamente um comentário.
          && next.size() == previous.size() + 1
          && next.size() <= 1000

          // O novo comentário fica no final e pertence ao membro.
          && validNewComment(next[previous.size()])
          && !(next[previous.size()] in previous)

          // Preserva os comentários anteriores e sua ordem.
          && next.removeAll([next[previous.size()]]) == previous;
      }

      // Admin edita; os demais apenas acrescentam comentário próprio.
     
      allow update: if activeMember()
        && validTaskPayload(request.resource.data)
        && request.resource.data.id == resource.data.id
        && (
          isAdmin()
          || (
            canReadTask(resource.data)
            && onlyAddsOwnComment()
          )
        );

      // Somente administrador exclui tarefas.
      allow delete: if isAdmin();
    }

    /*
     * ========================================
     * AUSÊNCIAS
     * ========================================
     */

    match /absences/{absenceId} {

      // Administrador vê todas; membro vê somente as próprias.
      allow read: if activeMember()
        && (
          isAdmin()
          || resource.data.memberId == memberData().id
        );

      // Admin cria para qualquer membro.
      // Membro cria somente a própria ausência.
      allow create: if activeMember()
        && request.resource.data.id == absenceId
        && (
          isAdmin()
          || isSelfByMemberId(request.resource.data.memberId)
        );

      // Membro não pode transferir sua ausência para outra pessoa.
      allow update: if activeMember()
        && request.resource.data.id == resource.data.id
        && (
          isAdmin()
          || (
            isSelfByMemberId(resource.data.memberId)
            && request.resource.data.memberId
              == resource.data.memberId
          )
        );

      allow delete: if activeMember()
        && (
          isAdmin()
          || isSelfByMemberId(resource.data.memberId)
        );
    }

    /*
     * ========================================
     * NOTIFICAÇÕES
     * ========================================
     */

    match /notifications/{notificationId} {

      // Admin lê todas; membro lê somente as próprias.
      allow read: if activeMember()
        && (
          isAdmin()
          || resource.data.userId == memberData().id
        );

      allow create: if activeMember()
        && request.resource.data.id == notificationId
        && (
          isAdmin()
          || request.resource.data.userId == memberData().id
        );

      // Admin pode atualizar.
// Membro pode apenas marcar sua própria notificação como lida.
allow update: if activeMember()
  && request.resource.data.id == resource.data.id
  && (
    isAdmin()
    || (
      resource.data.userId == memberData().id
      && request.resource.data.diff(resource.data)
        .affectedKeys()
        .hasOnly(['read'])
      && request.resource.data.read is bool
    )
  );

      allow delete: if isAdmin()
        || (
          activeMember()
          && resource.data.userId == memberData().id
        );
    }

    /*
     * ========================================
     * BLOQUEIO PADRÃO
     * ========================================
     */

    match /{document=**} {
      allow read, write: if false;
    }
  }
}